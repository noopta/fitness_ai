{
  "name": "axiom-mobile",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "postinstall": "node scripts/strip-posthog-session-replay-ios.js",
    "eas-build-post-install": "node scripts/strip-posthog-session-replay-ios.js",
    "ota": "node scripts/preflight-ota.js && eas update --branch production",
    "ota:force": "node scripts/preflight-ota.js --force && eas update --branch production",
    "release:android": "eas build --platform android --profile production --auto-submit",
    "release:ios": "eas build --platform ios --profile production --auto-submit",
    "release:all": "eas build --platform all --profile production --auto-submit",
    "release:promote-android": "eas submit --platform android --profile production-live --latest"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.11",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/react-native-skia": "2.4.18",
    "@tanstack/react-query": "^5.62.0",
    "anser": "^2.3.5",
    "babel-preset-expo": "~55.0.8",
    "expo": "^55.0.0",
    "expo-apple-authentication": "~55.0.13",
    "expo-asset": "~55.0.17",
    "expo-audio": "~55.0.14",
    "expo-blur": "~55.0.14",
    "expo-build-properties": "~55.0.14",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.35",
    "expo-device": "~55.0.17",
    "expo-file-system": "~55.0.22",
    "expo-font": "~55.0.8",
    "expo-image-manipulator": "~55.0.17",
    "expo-image-picker": "~55.0.20",
    "expo-linear-gradient": "~55.0.14",
    "expo-linking": "~55.0.15",
    "expo-media-library": "~55.0.17",
    "expo-notifications": "~55.0.23",
    "expo-router": "~55.0.16",
    "expo-secure-store": "~55.0.14",
    "expo-sharing": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.24",
    "expo-web-browser": "~55.0.16",
    "lucide-react-native": "^1.8.0",
    "posthog-react-native": "^4.41.1",
    "posthog-react-native-session-replay": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-iap": "^14.7.20",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-spotlight-tour": "^4.0.0",
    "react-native-svg": "15.15.3",
    "react-native-view-shot": "4.0.3",
    "react-native-vision-camera": "^4.7.3",
    "react-native-web": "^0.21.0",
    "react-native-web-webview": "^1.0.2",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "react-native-youtube-iframe": "^2.4.1"
